# Copy this file to `.env` and adjust per environment. Only `EXPO_PUBLIC_*`
# vars are bundled into the JS runtime by the Expo build.
#
# After editing, restart Metro with `npx expo start --clear` so the new
# values are baked into the bundle. Just restarting the server alone won't
# pick up new env values.

# ---- Mode --------------------------------------------------------------

# SCAFFOLD vs FULL mode. Leave unset (or `true`) to run against the in-memory
# mocks under lib/api/mocks/. Set to `false` to dispatch every endpoint
# through axios at EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_MOCK_API=true

# ---- Backend -----------------------------------------------------------

# Base URL of the backend. Required when EXPO_PUBLIC_MOCK_API=false. The
# wrappers in lib/api expect the v1 prefix to live on this host
# (e.g. https://api.example.com -> https://api.example.com/v1/identity/me).
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid

# ---- Legal + support ---------------------------------------------------

# Public privacy policy URL (must be https). Loaded inside an in-app
# WebView from Settings > Legal > Privacy Policy. If unset, the screen
# renders a "Document not configured" empty state instead.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Public terms of service URL (must be https). Same WebView treatment.
EXPO_PUBLIC_TERMS_URL=https://example.com/terms

# Mailto target for the in-app support row. If unset, the row toasts a
# "support email not configured" notice rather than opening the mail app.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# ---- Monitoring + push (FULL mode) -------------------------------------

# Sentry DSN. Stub in SCAFFOLD; required in FULL when monitoring is wired.
# EXPO_PUBLIC_SENTRY_DSN=

# Expo Application Services project ID for push token registration. Set
# after running `npx eas init`.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Environment label for Sentry tagging and conditional builds.
# One of: production / staging / development.
EXPO_PUBLIC_ENVIRONMENT=development
