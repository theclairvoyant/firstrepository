{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOCK_API": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.staging.enterprisecreator.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_MOCK_API": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.enterprisecreator.app"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
